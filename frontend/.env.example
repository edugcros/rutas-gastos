# URL del servicio remoto de planificación (sin viajes ni gastos).
# Dejar vacío deshabilita Gemini/Google Routes; la gestión local seguirá funcionando.
VITE_ROUTE_API_URL=
# Clave de navegador distinta de la clave privada del backend.
# Restringirla por HTTP referrer y exclusivamente a Maps JavaScript API.
VITE_GOOGLE_MAPS_BROWSER_KEY=

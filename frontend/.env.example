# Backend público de planificación. La aplicación trae un endpoint predeterminado;
# configurar esta variable solo si se cambia el servicio de Render.
VITE_ROUTE_API_URL=https://rutas-gastos-route-service.onrender.com/api

# Clave pública de navegador, restringida por HTTP referrer y Maps JavaScript API.
# Nunca colocar aquí la clave privada de Google Routes ni la clave de Gemini.
VITE_GOOGLE_MAPS_BROWSER_KEY=

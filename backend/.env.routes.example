NODE_ENV=production
PORT=5100

# Claves privadas del proveedor. Nunca se colocan en el frontend.
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Origen HTTPS donde se aloja el frontend PWA.
APP_ORIGINS=http://localhost:5173

# En Render configurar 1; en ejecución directa local, 0.
TRUST_PROXY_HOPS=0
ROUTE_LIMIT_PER_MINUTE=5
ROUTE_LIMIT_PER_DAY=25

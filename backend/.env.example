NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rutas_gastos
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
JWT_EXPIRES_IN=12h
FRONTEND_ORIGIN=http://localhost:5173

# Google Maps Routes API - CLAVE PRIVADA DEL BACKEND.
# Restringir en Google Cloud por IP y exclusivamente a Routes API.
GOOGLE_MAPS_API_KEY=

# Gemini - no exponer en el frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: endpoint Overpass para evaluar surface=* en etapas futuras.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Servicio independiente de planificación. No necesita MongoDB ni JWT.
APP_ORIGINS=https://TU-DOMINIO-PWA
TRUST_PROXY_HOPS=0
ROUTE_LIMIT_PER_MINUTE=5
ROUTE_LIMIT_PER_DAY=25
